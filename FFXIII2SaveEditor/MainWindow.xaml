<Window x:Class="FFXIII2SaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFXIII-2 PS3 Save Editor v1.9.33"
        Width="1280" Height="900" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Simple header, similar to the compact reference editor. -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" MinHeight="82">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/header.png" Stretch="Uniform" HorizontalAlignment="Center" Margin="20,0,12,0" />
                <Border Grid.Column="1" Background="{StaticResource Panel2Brush}" BorderBrush="#56535C" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="Region" Style="{StaticResource MutedLabel}"/><TextBlock x:Name="RegionText" Grid.Row="0" Grid.Column="1" Text="-"/>
                        <TextBlock Grid.Row="1" Text="Checksum" Style="{StaticResource MutedLabel}"/><TextBlock x:Name="ChecksumText" Grid.Row="1" Grid.Column="1" Text="-"/>
                        <TextBlock Grid.Row="2" Text="Access" Style="{StaticResource MutedLabel}"/><TextBlock x:Name="AccessText" Grid.Row="2" Grid.Column="1" Text="-"/>
                        <Button x:Name="OpenSaveButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="Open File" Click="OpenSave_Click" Padding="8,4" MinHeight="30"/>
                        <TextBlock x:Name="LoadedText" Grid.Row="2" Grid.Column="2" Text="-" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="11"/>
                        <TextBlock x:Name="SaveTypeText" Visibility="Collapsed" Text="Not loaded"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- One compact file bar. -->
        <Grid Grid.Row="1" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SaveFolderText" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" />
            <Button x:Name="LoadSaveButton" Grid.Column="1" Content="Load Save" Click="LoadSave_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
        </Grid>

        <!-- Main editor frame. -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7">
            <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="General">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                        <GroupBox Header="GIL / CP" Grid.Column="0">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Gil"/><TextBox x:Name="GilBox" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Text="Casino Coins"/><TextBox x:Name="CoinsBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Text="Serah CP"/><TextBox x:Name="SerahCpGeneralBox" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Text="Noel CP"/><TextBox x:Name="NoelCpGeneralBox" Grid.Row="3" Grid.Column="1"/>
                                <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Save Changes" Click="ApplyGeneral_Click" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="QUICK ITEMS" Grid.Column="2">
                            <DataGrid x:Name="QuickItemsGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/></DataGrid.Columns></DataGrid>
                        </GroupBox>
                        <GroupBox Header="SAVE PROGRESS" Grid.Column="4">
                            <StackPanel Margin="6">
                                <TextBlock Text="Fragments" Style="{StaticResource MutedLabel}"/><TextBlock x:Name="FragmentsProgressText" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,16"/>
                                <TextBlock Text="Tamed Monsters" Style="{StaticResource MutedLabel}"/><TextBlock x:Name="MonstersProgressText" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,16"/>
                                <TextBlock Text="Checksum is repaired automatically when edits are applied." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Characters">
                    <Grid Margin="8">
                        <TabControl>
                            <TabItem Header="Serah">
                                <Grid Margin="8">
                                    <TabControl>
                                        <TabItem Header="Stats">
                                            <Grid Margin="18" MaxWidth="700" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="CP"/><TextBox x:Name="SerahCP" Grid.Row="0" Grid.Column="1"/>
                                                <TextBlock Grid.Row="1" Text="HP"/><TextBox x:Name="SerahHP" Grid.Row="1" Grid.Column="1"/>
                                                <TextBlock Grid.Row="2" Text="Strength"/><TextBox x:Name="SerahStrength" Grid.Row="2" Grid.Column="1"/>
                                                <TextBlock Grid.Row="3" Text="Magic"/><TextBox x:Name="SerahMagic" Grid.Row="3" Grid.Column="1"/>
                                                <TextBlock Grid.Row="4" Text="ATB"/><TextBox x:Name="SerahATB" Grid.Row="4" Grid.Column="1"/>
                                                <TextBlock Grid.Row="5" Text="Equipment Capacity"/><TextBox x:Name="SerahCapacity" Grid.Row="5" Grid.Column="1"/>
                                                <Button Grid.Row="0" Grid.Column="3" Content="Save" Click="ApplySerah_Click" Style="{StaticResource PrimaryButton}"/>
                                                <Button Grid.Row="1" Grid.Column="3" Content="Max Stats" Click="MaxSerah_Click"/>
                                                <Button Grid.Row="2" Grid.Column="3" Content="Restore Loaded Stats" Click="RestoreSerah_Click" ToolTip="Restore mapped Serah stats to the exact values captured when this save was loaded."/>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Paradigm Roles">
                                            <Grid Margin="18" MaxWidth="760" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="44"/>
                                                    <RowDefinition Height="44"/>
                                                    <RowDefinition Height="44"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Grid.ColumnSpan="7" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,12">
                                                    <TextBlock Text="Edit Serah's six Crystarium role levels. Valid game range: 0–99. These fields change the saved role level only; they do not automatically rebuild Crystarium node history, learned abilities, HP, Strength or Magic." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                                </Border>

                                                <TextBlock Grid.Row="1" Text="Commando (COM)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="SerahRoleCOM" Grid.Row="1" Grid.Column="1"/>
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Ravager (RAV)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="SerahRoleRAV" Grid.Row="1" Grid.Column="4"/>

                                                <TextBlock Grid.Row="2" Text="Sentinel (SEN)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="SerahRoleSEN" Grid.Row="2" Grid.Column="1"/>
                                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Saboteur (SAB)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="SerahRoleSAB" Grid.Row="2" Grid.Column="4"/>

                                                <TextBlock Grid.Row="3" Text="Synergist (SYN)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="SerahRoleSYN" Grid.Row="3" Grid.Column="1"/>
                                                <TextBlock Grid.Row="3" Grid.Column="3" Text="Medic (MED)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="SerahRoleMED" Grid.Row="3" Grid.Column="4"/>

                                                <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="6">
                                                    <Button Content="Save Role Levels" Click="ApplySerahRoles_Click" Style="{StaticResource PrimaryButton}"/>
                                                    <Button Content="Max All to 99" Click="MaxSerahRoles_Click" Margin="0,9,0,0"/>
                                                    <Button Content="Restore Loaded Levels" Click="RestoreSerahRoles_Click" Margin="0,9,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="4" Grid.ColumnSpan="7" x:Name="SerahRoleStatusText" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Passives &amp; Resistances">
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
                                                    <TextBlock Text="Serah obtains these character passives through equipped accessories. This editor transforms an already-equipped accessory instance and keeps the verified equipment references intact. All known accessory IDs are available; entries with unmapped effect/capacity metadata are marked Unverified. Accessory synthesis-group bonus abilities may also change when the accessory is transformed." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                                </Border>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="310"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.1*" MinWidth="390"/></Grid.ColumnDefinitions>
                                                    <GroupBox Grid.Column="0" Header="EQUIPPED PASSIVES / RESISTANCES">
                                                        <DataGrid x:Name="SerahEquippedEffectsGrid" Tag="Serah" IsReadOnly="True" SelectionChanged="CharacterAccessoryGrid_SelectionChanged">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Slot" Binding="{Binding EquipPosition}" Width="55"/>
                                                                <DataGridTextColumn Header="Accessory" Binding="{Binding Name}" Width="160"/>
                                                                <DataGridTextColumn Header="Passive / Resistance" Binding="{Binding Effect}" Width="*"/>
                                                                <DataGridTextColumn Header="Cost" Binding="{Binding CapacityText}" Width="55"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </GroupBox>
                                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>
                                                    <GroupBox Grid.Column="2" Header="ALL ACCESSORIES">
                                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Search" Style="{StaticResource MutedLabel}"/><TextBox x:Name="SerahAccessorySearchBox" Tag="Serah" Grid.Column="1" TextChanged="CharacterAccessorySearchBox_TextChanged"/></Grid>
                                                            <DataGrid x:Name="SerahAccessoryCatalogGrid" Grid.Row="1" IsReadOnly="True" Margin="0,6,0,0">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Accessory" Binding="{Binding Name}" Width="155"/>
                                                                    <DataGridTextColumn Header="Passive / Resistance" Binding="{Binding Effect}" Width="*"/>
                                                                    <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="95"/>
                                                                    <DataGridTextColumn Header="Cost" Binding="{Binding CapacityText}" Width="50"/>
                                                                    <DataGridTextColumn Header="Safety" Binding="{Binding Safety}" Width="95"/>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </Grid>
                                                    </GroupBox>
                                                </Grid>
                                                <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SerahAccessoryStatusText" Text="Load a save to inspect equipped passives." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,0,10,0"/>
                                                    <Button Grid.Column="1" Tag="Serah" Content="Apply Selected Effect" Click="ReplaceCharacterAccessory_Click" Style="{StaticResource PrimaryButton}"/>
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Noel">
                                <Grid Margin="8">
                                    <TabControl>
                                        <TabItem Header="Stats">
                                            <Grid Margin="18" MaxWidth="700" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="CP"/><TextBox x:Name="NoelCP" Grid.Row="0" Grid.Column="1"/>
                                                <TextBlock Grid.Row="1" Text="HP"/><TextBox x:Name="NoelHP" Grid.Row="1" Grid.Column="1"/>
                                                <TextBlock Grid.Row="2" Text="Strength"/><TextBox x:Name="NoelStrength" Grid.Row="2" Grid.Column="1"/>
                                                <TextBlock Grid.Row="3" Text="Magic"/><TextBox x:Name="NoelMagic" Grid.Row="3" Grid.Column="1"/>
                                                <TextBlock Grid.Row="4" Text="ATB"/><TextBox x:Name="NoelATB" Grid.Row="4" Grid.Column="1"/>
                                                <TextBlock Grid.Row="5" Text="Equipment Capacity"/><TextBox x:Name="NoelCapacity" Grid.Row="5" Grid.Column="1"/>
                                                <Button Grid.Row="0" Grid.Column="3" Content="Save" Click="ApplyNoel_Click" Style="{StaticResource PrimaryButton}"/>
                                                <Button Grid.Row="1" Grid.Column="3" Content="Max Stats" Click="MaxNoel_Click"/>
                                                <Button Grid.Row="2" Grid.Column="3" Content="Restore Loaded Stats" Click="RestoreNoel_Click" ToolTip="Restore mapped Noel stats to the exact values captured when this save was loaded."/>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Paradigm Roles">
                                            <Grid Margin="18" MaxWidth="760" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="44"/>
                                                    <RowDefinition Height="44"/>
                                                    <RowDefinition Height="44"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Grid.ColumnSpan="7" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,12">
                                                    <TextBlock Text="Edit Noel's six Crystarium role levels. Valid game range: 0–99. These fields change the saved role level only; they do not automatically rebuild Crystarium node history, learned abilities, HP, Strength or Magic." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                                </Border>

                                                <TextBlock Grid.Row="1" Text="Commando (COM)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NoelRoleCOM" Grid.Row="1" Grid.Column="1"/>
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Ravager (RAV)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NoelRoleRAV" Grid.Row="1" Grid.Column="4"/>

                                                <TextBlock Grid.Row="2" Text="Sentinel (SEN)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NoelRoleSEN" Grid.Row="2" Grid.Column="1"/>
                                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Saboteur (SAB)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NoelRoleSAB" Grid.Row="2" Grid.Column="4"/>

                                                <TextBlock Grid.Row="3" Text="Synergist (SYN)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NoelRoleSYN" Grid.Row="3" Grid.Column="1"/>
                                                <TextBlock Grid.Row="3" Grid.Column="3" Text="Medic (MED)" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NoelRoleMED" Grid.Row="3" Grid.Column="4"/>

                                                <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="6">
                                                    <Button Content="Save Role Levels" Click="ApplyNoelRoles_Click" Style="{StaticResource PrimaryButton}"/>
                                                    <Button Content="Max All to 99" Click="MaxNoelRoles_Click" Margin="0,9,0,0"/>
                                                    <Button Content="Restore Loaded Levels" Click="RestoreNoelRoles_Click" Margin="0,9,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="4" Grid.ColumnSpan="7" x:Name="NoelRoleStatusText" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Passives &amp; Resistances">
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
                                                    <TextBlock Text="Noel obtains these character passives through equipped accessories. This editor transforms an already-equipped accessory instance and keeps the verified equipment references intact. All known accessory IDs are available; entries with unmapped effect/capacity metadata are marked Unverified. Accessory synthesis-group bonus abilities may also change when the accessory is transformed." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                                </Border>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="310"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.1*" MinWidth="390"/></Grid.ColumnDefinitions>
                                                    <GroupBox Grid.Column="0" Header="EQUIPPED PASSIVES / RESISTANCES">
                                                        <DataGrid x:Name="NoelEquippedEffectsGrid" Tag="Noel" IsReadOnly="True" SelectionChanged="CharacterAccessoryGrid_SelectionChanged">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Slot" Binding="{Binding EquipPosition}" Width="55"/>
                                                                <DataGridTextColumn Header="Accessory" Binding="{Binding Name}" Width="160"/>
                                                                <DataGridTextColumn Header="Passive / Resistance" Binding="{Binding Effect}" Width="*"/>
                                                                <DataGridTextColumn Header="Cost" Binding="{Binding CapacityText}" Width="55"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </GroupBox>
                                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>
                                                    <GroupBox Grid.Column="2" Header="ALL ACCESSORIES">
                                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Search" Style="{StaticResource MutedLabel}"/><TextBox x:Name="NoelAccessorySearchBox" Tag="Noel" Grid.Column="1" TextChanged="CharacterAccessorySearchBox_TextChanged"/></Grid>
                                                            <DataGrid x:Name="NoelAccessoryCatalogGrid" Grid.Row="1" IsReadOnly="True" Margin="0,6,0,0">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Accessory" Binding="{Binding Name}" Width="155"/>
                                                                    <DataGridTextColumn Header="Passive / Resistance" Binding="{Binding Effect}" Width="*"/>
                                                                    <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="95"/>
                                                                    <DataGridTextColumn Header="Cost" Binding="{Binding CapacityText}" Width="50"/>
                                                                    <DataGridTextColumn Header="Safety" Binding="{Binding Safety}" Width="95"/>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </Grid>
                                                    </GroupBox>
                                                </Grid>
                                                <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="NoelAccessoryStatusText" Text="Load a save to inspect equipped passives." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,0,10,0"/>
                                                    <Button Grid.Column="1" Tag="Noel" Content="Apply Selected Effect" Click="ReplaceCharacterAccessory_Click" Style="{StaticResource PrimaryButton}"/>
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Lightning DLC">
                                <Grid Margin="18" MaxWidth="700" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CP"/><TextBox x:Name="LightningCP" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="1" Text="HP"/><TextBox x:Name="LightningHP" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Text="Strength"/><TextBox x:Name="LightningStrength" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Grid.Row="3" Text="Magic"/><TextBox x:Name="LightningMagic" Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Grid.Row="4" Text="ATB"/><TextBox x:Name="LightningATB" Grid.Row="4" Grid.Column="1"/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="Max Stats" Click="MaxLightning_Click"/>
                                    <Button Grid.Row="0" Grid.Column="3" Content="Save" Click="ApplyLightning_Click" Style="{StaticResource PrimaryButton}"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Inventory">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Search" Style="{StaticResource MutedLabel}"/>
                            <TextBox x:Name="InventorySearchBox" Grid.Column="1" Margin="0,0,14,0" TextChanged="InventorySearchBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="Mode" Style="{StaticResource MutedLabel}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbInventoryMode" Grid.Column="3" Width="180" SelectionChanged="InventoryMode_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="Simple (Recommended)" Tag="simple"/>
                                <ComboBoxItem Content="Advanced" Tag="advanced"/>
                            </ComboBox>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                            <TextBlock x:Name="txtInventoryModeHint" Text="Simple: ordinary stackable inventory only (recommended)." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </Border>

                        <DataGrid x:Name="InventoryGrid" Grid.Row="2" Margin="0,0,0,8" SelectionChanged="InventoryGrid_SelectionChanged" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="240"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedInventoryName" Text="Select an item" FontSize="15" FontWeight="SemiBold" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="InventoryQtyBox" Grid.Column="1" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Save" Click="ApplyInventory_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                            <Button Grid.Column="3" Content="Max Selected" Click="MaxInventory_Click" Margin="0,0,10,0"/>
                            <Button Grid.Column="4" Content="Max Safe Inventory" Click="MaxAllSafeInventory_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Adornments">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Search" Style="{StaticResource MutedLabel}"/>
                            <TextBox x:Name="AdornmentSearchBox" Grid.Column="1" TextChanged="AdornmentSearchBox_TextChanged"/>
                            <TextBlock x:Name="AdornmentCountText" Grid.Column="2" Text="0 / 0 owned" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </Grid>
                        <DataGrid x:Name="AdornmentGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Owned" Binding="{Binding Owned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                <DataGridTextColumn Header="Adornment" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Select All" Click="SelectAllAdornments_Click" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Clear All" Click="ClearAllAdornments_Click" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="Choose Owned or Not Owned for each adornment, then apply." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="8,0"/>
                            <Button Grid.Column="3" Content="Apply Selection" Click="ApplyAdornments_Click" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Party / Guests">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="STORY GUEST PARTY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="GuestPartyStatusText"
                                           Text="Story Guest slot is research-only."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="GuestPartyGrid"
                                      Grid.Column="0"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="GuestPartySelectionChanged"
                                      Margin="0,0,10,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Guest" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="SELECTED GUEST" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    <TextBlock x:Name="GuestPartySelectedText" Text="Select an option" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="GuestPartySelectedStatusText" Text="-" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="GuestPartySelectedNoteText" Text="No guest selected." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Snow (Story Guest) is intentionally disabled until the exact APP.DAT guest-party field is verified."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Button x:Name="ApplyGuestPartyButton"
                                    Grid.Column="1"
                                    Content="Apply Guest"
                                    Click="ApplyGuestParty_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Equipment">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="OWNED EQUIPMENT" Grid.Column="0">
                            <DataGrid x:Name="OwnedEquipmentGrid" IsReadOnly="True" SelectionChanged="OwnedEquipmentGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Equipment" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="70"/></DataGrid.Columns></DataGrid>
                        </GroupBox>
                        <GroupBox Header="REPLACEMENT CATALOG" Grid.Column="2">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Search" Style="{StaticResource MutedLabel}"/><TextBox x:Name="EquipmentSearchBox" Grid.Column="1" TextChanged="EquipmentSearchBox_TextChanged"/></Grid>
                                <DataGrid x:Name="EquipmentCatalogGrid" Grid.Row="1" IsReadOnly="True" Margin="0,5,0,8"><DataGrid.Columns><DataGridTextColumn Header="Equipment" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Owned" Binding="{Binding Ownership}" Width="90"/></DataGrid.Columns></DataGrid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Replace Selected" Click="ReplaceEquipment_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="Add Missing" Click="AddMissingEquipment_Click" Margin="6,0,0,6"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="All Serah Weapons" Click="AddAllSerahWeapons_Click" Margin="0,0,6,0"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="All Noel Weapons" Click="AddAllNoelWeapons_Click" Margin="6,0"/>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Monster Lab">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.38*" MinWidth="260" MaxWidth="400"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.62*" MinWidth="500"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="MONSTER LIBRARY" Grid.Column="0">
                            <Grid Margin="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Search" Style="{StaticResource MutedLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="MonsterSearchBox" TextChanged="MonsterSearchBox_TextChanged"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <CheckBox x:Name="MissingRealImagesOnlyCheckBox"
                                                      Content="Missing real images"
                                                      Checked="MissingRealImagesOnly_Checked"
                                                      Unchecked="MissingRealImagesOnly_Checked"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <Button Content="Refresh Images"
                                                    Click="RefreshMonsterImages_Click"
                                                    MinWidth="96"
                                                    Padding="6,2"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="Open Image Folder"
                                                    Click="OpenMonsterImagesFolder_Click"
                                                    MinWidth="112"
                                                    Padding="6,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,5,0,5" Padding="7">
                                        <StackPanel>
                                            <TextBlock Text="ULTIMATE PARADIGM PACK" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="Recommended general endgame core. Buttons are enabled only when that monster is actually owned." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                            <TextBlock x:Name="UltimatePackStatusText" Text="Recommended core owned: 0 / 3" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,0,0,5"/>
                                            <UniformGrid Columns="3">
                                                <Button x:Name="UltimateChichuButton" Content="Chichu • COM" Click="UltimatePackChichu_Click" Margin="0,0,3,0" Padding="3"/>
                                                <Button x:Name="UltimateCloudburstButton" Content="Cloudburst • RAV" Click="UltimatePackCloudburst_Click" Margin="0,0,3,0" Padding="3"/>
                                                <Button x:Name="UltimatePurpleChocoboButton" Content="Purple • SYN" Click="UltimatePackPurpleChocobo_Click" Padding="3"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="MonsterGrid" Grid.Row="1" MinHeight="120" IsReadOnly="True"
                                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                              SelectionChanged="MonsterGrid_SelectionChanged" Margin="0,0,0,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Monster" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Lv / Max" Binding="{Binding LevelDisplay}" Width="72"/>
                                            <DataGridTextColumn Header="HP" Binding="{Binding HP}" Width="78"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <Border Grid.Row="2" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,6" MinHeight="48" Margin="0,2,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MONSTER IMAGE COVERAGE" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock x:Name="MonsterImageCoverageText" Text="Images: load a save" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3,0,5"/>
                                        <TextBlock Text="ABILITY LAYOUT" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock x:Name="AbilityLayoutStatusText" Text="Load a save to verify skill layout." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

                        <TabControl x:Name="MonsterEditorTabs" Grid.Column="2">
                            <TabItem Header="Overview">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0" Focusable="False">
                                <Grid Margin="10" MinWidth="720" MinHeight="390">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Background="#161616" BorderBrush="#5C5962" BorderThickness="1" CornerRadius="7" Padding="8" Width="225" Height="225"><Image x:Name="MonsterImage" Width="207" Height="207" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                        <TextBlock x:Name="MonsterNameText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="MonsterSlotText" Style="{StaticResource MutedLabel}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="MonsterRoleText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="MonsterImageSourceText" Text="Built-in fallback icon" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,10,0,0" Width="225">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Active skills" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MonsterSkillCountText" Grid.Column="1" Text="0 / 32" FontSize="11" FontWeight="SemiBold"/></Grid>
                                                <ProgressBar x:Name="MonsterSkillProgress" Minimum="0" Maximum="32" Height="7" Margin="0,4,0,8"/>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Passives" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MonsterPassiveCountText" Grid.Column="1" Text="0 / 10" FontSize="11" FontWeight="SemiBold"/></Grid>
                                                <ProgressBar x:Name="MonsterPassiveProgress" Minimum="0" Maximum="10" Height="7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <GroupBox Header="STATS / GROWTH" Grid.Column="2">
                                        <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="MonsterLevelLabel" Grid.Row="0" Text="Level"/><TextBox x:Name="MonsterLevelBox" Grid.Row="0" Grid.Column="1"/>
                                            <TextBlock Grid.Row="1" Text="HP"/><TextBox x:Name="MonsterHpBox" Grid.Row="1" Grid.Column="1"/>
                                            <TextBlock Grid.Row="2" Text="Strength"/><TextBox x:Name="MonsterStrengthBox" Grid.Row="2" Grid.Column="1"/>
                                            <TextBlock Grid.Row="3" Text="Magic"/><TextBox x:Name="MonsterMagicBox" Grid.Row="3" Grid.Column="1"/>
                                            <TextBlock Grid.Row="4" Text="ATB"/><TextBox x:Name="MonsterAtbBox" Grid.Row="4" Grid.Column="1"/>
                                        </Grid>
                                    </GroupBox>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Button Content="Save Monster" Click="ApplyMonster_Click" Style="{StaticResource PrimaryButton}"/>
                                        <Button Content="Max This Monster" Click="MaxMonster_Click" Margin="0,9,0,0"/>
                                        <Button Content="Max All (Real Levels)" Click="MaxAllMonsters_Click" Margin="0,9,0,0"/>
                                        <Button Content="Correct All Levels" Click="CorrectAllMonsterLevels_Click" Margin="0,9,0,0" ToolTip="Clamp only impossible over-cap monster levels to each species' verified real maximum. Valid lower levels and unmapped IDs are preserved."/>
                                        <Separator Margin="0,14"/>
                                        <Button Content="Restore All Monster Stats" Click="RestoreAllMonsters_Click" ToolTip="Restore Level, HP, Strength, Magic and ATB from the exact save state captured at load time."/>
                                        <Button Content="Restore Serah + Noel + Monsters" Click="RestoreSerahNoelAndMonsters_Click" Margin="0,9,0,0" ToolTip="Restore mapped Serah/Noel stats and all matching monster stats from the load-time snapshot."/>
                                        <Separator Margin="0,14"/>
                                        <Button x:Name="UndoMonsterButton" Content="Undo Monster Edit" Click="UndoMonsterEdit_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Max Level Reference">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="REAL MONSTER MAX LEVELS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="Complete reference for the 152 main-game recruits plus 12 DLC/reward variants. The editor automatically enforces a cap only when the monster's real APP.DAT ID is mapped; unmapped DLC IDs remain reference-only rather than guessed." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Search" Style="{StaticResource MutedLabel}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="MonsterLevelReferenceSearchBox" Grid.Column="1" TextChanged="MonsterLevelReferenceSearchBox_TextChanged"/>
                                        <TextBlock x:Name="MonsterLevelReferenceCountText" Grid.Column="2" Text="164 variants" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                    <DataGrid x:Name="MonsterLevelReferenceGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Monster" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                                            <DataGridTextColumn Header="Real Max Level" Binding="{Binding MaxLevel}" Width="125"/>
                                            <DataGridTextColumn Header="Save Mapping" Binding="{Binding Mapping}" Width="145"/>
                                            <DataGridTextColumn Header="ID / Reference" Binding="{Binding Id}" Width="170"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="3" Text="Source cross-check: FFExodus recruitable-monster role tables and Final Fantasy Wiki Paradigm Pack DLC table. Reference-only means the max level is known, but the DLC monster's internal PS3 APP.DAT ID is not yet verified." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Chocobo Racing">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <Grid Margin="18" MaxWidth="850" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="CHOCOBO RACING" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="RaceEligibilityText" Text="Select a chocobo in the Monster Library." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <GroupBox Grid.Column="0" Header="SPEED">
                                                <StackPanel Margin="10">
                                                    <TextBlock x:Name="RaceSpeedText" Text="-" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="RaceSpeedSourceText" Text="Strength: -" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                    <ProgressBar x:Name="RaceSpeedProgress" Minimum="0" Maximum="800" Height="10"/>
                                                    <TextBlock Text="Race Speed is based on Strength; 800 is the effective cap." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </GroupBox>
                                            <GroupBox Grid.Column="2" Header="STAMINA">
                                                <StackPanel Margin="10">
                                                    <TextBlock x:Name="RaceStaminaText" Text="-" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="RaceStaminaSourceText" Text="Magic: -" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                    <ProgressBar x:Name="RaceStaminaProgress" Minimum="0" Maximum="800" Height="10"/>
                                                    <TextBlock Text="Race Stamina is based on Magic; 800 is the effective cap." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </GroupBox>
                                        </Grid>

                                        <GroupBox Grid.Row="2" Header="RACE POINTS (RP) — DIRECT SAVE VALUE" Margin="0,12,0,0">
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="RaceRpText" Text="-" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="RP:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBox x:Name="RaceRpBox" Width="90" Text="0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                                        <Button x:Name="ApplyRaceRpButton" Content="Apply RP" Click="ApplyChocoboRaceRp_Click" Style="{StaticResource PrimaryButton}" MinWidth="105" IsEnabled="False"/>
                                                    </StackPanel>
                                                    <ProgressBar x:Name="RaceRpProgress" Minimum="0" Maximum="600" Height="10" Margin="0,8,0,0"/>
                                                    <TextBlock x:Name="RaceRpSourceText" Text="Load a save to read the current racing profile RP." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                                    <TextBlock Text="RP is stored directly in the Chocobo Racing profile (0–600). It is not calculated from monster HP." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>

                                        <GroupBox Grid.Row="3" Header="RACE ABILITIES — 15 CATALOG / 10 PASSIVE-SLOT MAX" Margin="0,12,0,0">
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="340"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock x:Name="RaceAbilityCountText" Text="15 race abilities available • select a tamed chocobo to edit" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                <DataGrid x:Name="RaceAbilitiesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,8,0,8" SelectionChanged="RaceAbilitiesGrid_SelectionChanged">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="76"/>
                                                        <DataGridTextColumn Header="Race Ability" Binding="{Binding Name}" Width="132"/>
                                                        <DataGridTextColumn Header="Passive Source" Binding="{Binding SourcePassive}" Width="190"/>
                                                        <DataGridTextColumn Header="Effect" Binding="{Binding Effect}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Grid.Row="2" Text="Race abilities are generated by monster passives. Add Selected writes the preferred mapped source shown above. All 15 are editable, but only 10 passive-derived abilities can be active at once because a monster has 10 passive slots." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                                                    <Button x:Name="RemoveRaceAbilityButton" Content="Remove Selected" Click="RemoveChocoboRaceAbility_Click" IsEnabled="False" MinWidth="140" Margin="0,0,8,0"/>
                                                    <Button x:Name="AddRaceAbilityButton" Content="Add Selected Ability" Click="AddChocoboRaceAbility_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" MinWidth="165"/>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>

                                        <Border Grid.Row="4" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="178"/><ColumnDefinition Width="10"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="GOD CHOCOBO — BEST 10" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Performance-first universal setup: Blue Streak + Second Wind, Supersonic + Runaway, Sprinter, Marathoner, Limelight, Health Nut, Free Spirit, and Attention Hog. The preset replaces all 10 passive slots, raises STR/MAG to 800 / 800 minimum, and sets the direct racing-profile RP value to 600." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="MaxChocoboRaceButton" Grid.Column="1" Content="Max Racing Stats" Click="MaxChocoboRaceStats_Click" IsEnabled="False"/>
                                                <Button x:Name="GodChocoboButton" Grid.Column="3" Content="Apply God Chocobo" Click="ApplyGodChocoboPreset_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Skills">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                                    <GroupBox Header="CURRENT ACTIVE SKILLS" Grid.Column="0">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DataGrid x:Name="CurrentSkillsGrid" IsReadOnly="True" MinHeight="120">
                                                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Slot}" Width="46"/><DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="92"/></DataGrid.Columns>
                                            </DataGrid>
                                            <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <Button Grid.Row="0" Grid.Column="0" Content="Replace" Click="ReplaceSkill_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,5,5"/>
                                                <Button Grid.Row="0" Grid.Column="1" Content="Add to Empty" Click="AddSkill_Click" Margin="5,0,5,5"/>
                                                <Button Grid.Row="0" Grid.Column="2" Content="Remove" Click="RemoveSkill_Click" Margin="5,0,0,5"/>
                                                <Button Grid.Row="1" Grid.Column="0" Content="Move Up" Click="MoveSkillUp_Click" Margin="0,3,5,3"/>
                                                <Button Grid.Row="1" Grid.Column="1" Content="Move Down" Click="MoveSkillDown_Click" Margin="5,3,5,3"/>
                                                <Button Grid.Row="2" Grid.Column="0" Content="Copy Skills" Click="CopySkills_Click" Margin="0,5,5,0"/>
                                                <Button Grid.Row="2" Grid.Column="1" Content="Paste Skills" Click="PasteSkills_Click" Margin="5,5,5,0"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" ResizeDirection="Columns"/>
                                    <GroupBox Header="ABILITY CATALOG" Grid.Column="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Search" Style="{StaticResource MutedLabel}"/><TextBox x:Name="SkillSearchBox" Grid.Column="1" TextChanged="SkillSearchBox_TextChanged"/></Grid>
                                            <DataGrid x:Name="AvailableSkillsGrid" Grid.Row="1" IsReadOnly="True" MinHeight="120" Margin="0,5,0,6">
                                                <DataGrid.Columns><DataGridTextColumn Header="Ability" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="105"/><DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="125"/></DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Grid.Row="2" Text="Safe mode protects Feral Link. Adding/removing is enabled only when this save's ability-count field is detected with high confidence; replacing an existing slot remains available." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,2"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Passives">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.15*" MinWidth="300"/></Grid.ColumnDefinitions>
                                        <GroupBox Header="CURRENT PASSIVES" Grid.Column="0">
                                            <DataGrid x:Name="CurrentTraitsGrid" IsReadOnly="True" MinHeight="120" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="PassiveSelectionChanged">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="52"/>
                                                    <DataGridTextColumn Header="Passive" Binding="{Binding Name}" Width="155"/>
                                                    <DataGridTextColumn Header="What it does" Binding="{Binding Description}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" ResizeDirection="Columns"/>
                                        <GroupBox Header="PASSIVE CATALOG" Grid.Column="2">
                                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Search" Style="{StaticResource MutedLabel}"/><TextBox x:Name="TraitSearchBox" Grid.Column="1" TextChanged="TraitSearchBox_TextChanged"/></Grid><DataGrid x:Name="AvailableTraitsGrid" Grid.Row="1" IsReadOnly="True" MinHeight="120" SelectionMode="Single" SelectionUnit="FullRow" Margin="0,5,0,0" SelectionChanged="PassiveSelectionChanged">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Passive" Binding="{Binding Name}" Width="165"/>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="125"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="62"/>
                                                    <DataGridTextColumn Header="What it does" Binding="{Binding Description}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid></Grid>
                                        </GroupBox>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="SELECTED PASSIVE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,10,2"/>
                                                    <TextBlock x:Name="PassiveDetailNameText" Grid.Column="1" Text="Select a passive above" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                    <TextBlock Grid.Row="1" Text="Mode / Category" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,2"/>
                                                    <TextBlock x:Name="PassiveDetailCategoryText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="PassiveDetailEffectText" Grid.Row="2" Grid.ColumnSpan="2" Text="The effect of the selected passive will appear here." TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="PassiveAdvancedWarningText" Grid.Row="3" Grid.ColumnSpan="2" Text="Advanced / role passive: Red/Yellow Lock state is not mapped. Replace intentionally." Foreground="#FFFFB74D" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <WrapPanel HorizontalAlignment="Center">
                                                <Button Content="Add / Upgrade" Click="AddTrait_Click" Style="{StaticResource PrimaryButton}" MinWidth="125" Margin="3" ToolTip="Upgrade the same passive family. When the exact active/passive counters validate, this can add to an empty slot; otherwise select an occupied current slot for a count-neutral replacement."/>
                                                <Button Content="Replace Selected" Click="ReplaceTraitSlot_Click" MinWidth="125" Margin="3" ToolTip="Writes the selected catalog passive into the selected current passive slot."/>
                                                <Button Content="Remove" Click="RemoveTrait_Click" MinWidth="85" Margin="3"/>
                                                <Button Content="Clear Resists" Click="ClearResists_Click" MinWidth="105" Margin="3"/>
                                                <Button Content="Copy 10" Click="CopyTraits_Click" MinWidth="85" Margin="3"/>
                                                <Button Content="Paste 10" Click="PasteTraits_Click" MinWidth="85" Margin="3"/>
                                            </WrapPanel>
                                            <TextBlock Text="Manual replacement of an occupied passive is count-neutral. Adding/removing passives is enabled when the verified active and passive counters at record+0x286/+0x287 validate for this save." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10.5" Margin="4,4,4,0" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Passive Presets">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="RECOMMENDED PASSIVE PRESETS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Choose a ready-made safe passive setup for the selected monster. Automated presets use mapped normal passives only and never add new awp_* advanced passives." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="6,5,6,0"/>
                                            </StackPanel>
                                        </Border>

                                        <GroupBox Grid.Row="1" Header="ROLE PRESETS" Margin="0,0,0,10">
                                            <WrapPanel HorizontalAlignment="Center" Margin="8">
                                                <Button Content="Auto Role" Tag="AUTO" Click="ApplyPassivePreset_Click" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="5" ToolTip="Chooses COM, RAV, MED or Tank from the selected monster's detected active-skill role. Other roles use Balanced."/>
                                                <Button Content="Best COM" Tag="COM" Click="ApplyPassivePreset_Click" MinWidth="110" Margin="5" ToolTip="Recommended offensive passive setup for Commando-focused monsters."/>
                                                <Button Content="Best RAV" Tag="RAV" Click="ApplyPassivePreset_Click" MinWidth="110" Margin="5" ToolTip="Recommended chain-building passive setup for Ravager-focused monsters."/>
                                                <Button Content="Best MED" Tag="MED" Click="ApplyPassivePreset_Click" MinWidth="110" Margin="5" ToolTip="Recommended healing/support passive setup for Medic-focused monsters."/>
                                                <Button Content="Tank" Tag="TANK" Click="ApplyPassivePreset_Click" MinWidth="110" Margin="5" ToolTip="Recommended defensive passive setup for Sentinel/tank monsters."/>
                                                <Button Content="Balanced" Tag="BALANCED" Click="ApplyPassivePreset_Click" MinWidth="110" Margin="5" ToolTip="General-purpose passive setup when no single role should dominate."/>
                                            </WrapPanel>
                                        </GroupBox>

                                        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="HOW PRESETS WORK" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                <TextBlock Text="Presets preserve existing advanced awp_* slots and never inject new awp_* IDs because Red/Yellow Lock metadata is not mapped. If the total ability count is unverified, presets only replace occupied normal slots." TextWrapping="Wrap"/>
                                                <TextBlock Text="Use the Passives tab next door to review every passive, read its effect, and make manual replacements after applying a preset." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Row="3" Text="Tip: select a monster first, then choose Auto Role for the quickest recommended setup." Foreground="{StaticResource MutedBrush}" FontStyle="Italic" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Infusion (Safe)">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="Donor monster" FontWeight="SemiBold"/><ComboBox x:Name="InfusionDonorCombo" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="InfusionDonorCombo_SelectionChanged" Margin="6,0,15,0" MaxDropDownHeight="240" Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/><Button Grid.Column="2" Content="Select All" Click="InfusionSelectAll_Click" Margin="0,0,6,0"/><Button Grid.Column="3" Content="Clear" Click="InfusionClearAll_Click"/></Grid>
                                    <DataGrid x:Name="InfusionTransferGrid" Grid.Row="1" MinHeight="150" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended">
                                        <DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding Include, Mode=TwoWay}" Width="48"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="78"/><DataGridTextColumn Header="Ability / Passive" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Notes" Binding="{Binding Note}" IsReadOnly="True" Width="170"/></DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="InfusionPreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Choose a donor. This editor performs a controlled manual transfer and keeps the donor monster intact for save safety."/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><Button Content="Preview Transfer" Click="PreviewInfusion_Click"/><Button Content="Apply Transfer" Click="ApplyInfusion_Click" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/></StackPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Fragments">
                    <Grid Margin="8">
                        <TabControl>
                            <TabItem Header="Fragment Skills">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
                                    <GroupBox Header="FRAGMENT SKILLS">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="FragmentSkillsMaskText" Margin="4,2,4,8" FontWeight="SemiBold"/>
                                            <DataGrid x:Name="FragmentSkillsGrid" Grid.Row="1" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="220"/>
                                                    <DataGridTextColumn Header="Unlocked" Binding="{Binding Unlocked}" Width="90"/>
                                                    <DataGridTextColumn Header="Effect" Binding="{Binding Effect}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Header="VERIFIED ACTIONS" Grid.Column="2">
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Content="Toggle Selected" Click="ToggleFragmentSkill_Click"/>
                                            <Button Content="Unlock All 14 (Verified)" Click="UnlockAllSkills_Click" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
                                            <Button Content="Clear All Known Skills" Click="ClearAllSkills_Click" Margin="0,8,0,0"/>
                                            <TextBlock Text="Verified real-save target: APP.DAT + 0x17A56 = 0x0007FFFF. Unlock All sets all 19 known bits used by the 14 Fragment Skills while preserving any unknown/reserved bits outside that mask." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,18,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Casino Records">
                    <Grid Margin="18" MaxWidth="850" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="POKER" Grid.Column="0">
                            <Grid Margin="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Games Played"/><TextBox x:Name="PokerGamesPlayedBox" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Text="Games Won"/><TextBox x:Name="PokerGamesWonBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Text="Matches Won"/><TextBox x:Name="PokerMatchesWonBox" Grid.Row="2" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="CHRONOBIND" Grid.Column="2">
                            <Grid Margin="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Games Played"/><TextBox x:Name="ChronobindGamesPlayedBox" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Text="Games Won"/><TextBox x:Name="ChronobindGamesWonBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Text="Matches Won"/><TextBox x:Name="ChronobindMatchesWonBox" Grid.Row="2" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                        <StackPanel Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,0,0,18">
                            <TextBlock Text="Poker and Chronobind record counters. Games Played locations were verified from controlled real-save comparisons; the adjacent Won / Matches Won fields use the same mapped BE16 record structure."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button Content="Save Casino Records" Click="ApplyCasinoRecords_Click" Style="{StaticResource PrimaryButton}" Width="220" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Simple footer actions, like a classic save editor. -->
        <Grid Grid.Row="3" Margin="4,8,4,0" MinHeight="34">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="170"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Open a Final Fantasy XIII-2 PS3 save to begin." Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
            <Button x:Name="ExportDecryptedButton" Grid.Column="1" Content="Decrypted Backup" IsEnabled="False" Click="ExportDecrypted_Click" Margin="0,0,7,0"/>
            <Button x:Name="SaveEncryptedButton" Grid.Column="2" Content="Encrypted Copy" IsEnabled="False" Click="SaveEncryptedCopy_Click" Margin="0,0,7,0"/>
            <Button x:Name="SaveInPlaceButton" Grid.Column="3" Content="Save + Backup" IsEnabled="False" Click="SaveInPlace_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
